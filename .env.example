# JobFinder Pro Configuration

# 1. Email Configuration (Gmail App Password)
# To create an App Password: Google Account > Security > 2-Step Verification > App Passwords
GMAIL_USER=abdurfreelance@gmail.com
GMAIL_APP_PASSWORD=your_16_digit_app_password_here

# 2. Safety & Sending Controls
# DRY_RUN=true creates drafts, PDFs, and logs WITHOUT sending actual emails
DRY_RUN=true
DAILY_EMAIL_LIMIT=30
MIN_DELAY_SECONDS=45
MAX_DELAY_SECONDS=120

# 3. Apollo.io API (Optional for decision maker discovery)
# Get a free API key at https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=

# 4. OpenRouter Free AI Models (Optional - Free Cloud LLM Tailoring)
# Get a free API key at https://openrouter.ai/keys
USE_OPENROUTER=true
OPENROUTER_API_KEY=
# Popular 100% Free models on OpenRouter:
# - meta-llama/llama-3.2-3b-instruct:free
# - google/gemini-2.0-flash-exp:free
# - deepseek/deepseek-r1:free
# - qwen/qwen-2.5-coder-32b-instruct:free
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free

# 5. Local Ollama LLM (Alternative offline option)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
USE_OLLAMA=false
