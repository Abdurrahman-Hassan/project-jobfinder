# ==========================================
# JobFinder Pro Environment Configuration
# ==========================================

# 1. Gmail App Password (Outreach Sender)
# Generate from: Google Account -> Security -> 2-Step Verification -> App Passwords
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_gmail_app_password

# 2. Outreach Safety & Guardrails
DRY_RUN=true
DAILY_EMAIL_LIMIT=20
MIN_DELAY_SECONDS=45
MAX_DELAY_SECONDS=90

# 3. Apollo.io API (Decision Maker Lead Enrichment)
# Free Key from: https://app.apollo.io/#/settings/api
APOLLO_API_KEY=your_apollo_api_key_here

# 4. OpenRouter Cloud LLM (Optional - for advanced ATS rewriting)
# Free models: meta-llama/llama-3.2-3b-instruct:free, google/gemini-2.0-flash-exp:free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free
USE_OPENROUTER=true

# 5. Search Engine & Browser Customization
# Choose default engine: bing | google | all
DEFAULT_SEARCH_ENGINE=bing

# Choose browser: chrome | edge | brave | chromium | custom
BROWSER_TYPE=chrome
# Optional custom executable path:
# BROWSER_PATH=C:\Program Files\BraveSoftware\Brave-Browser\Application\brave.exe


# BROWSER_TYPE=camoufox
# BROWSER_PATH=C:\Users\Abdurrahman\AppData\Local\camoufox\camoufox.exe